# Copy to .env and edit locally; never commit real credentials or media.
ZILCHO_PASSWORD=replace-with-your-own-long-password
# These are examples. Verify your actual Unraid host paths.
MEDIA_PATH=/mnt/user/data/media
DOWNLOADS_PATH=/mnt/user/data/torrents
APPDATA_PATH=/mnt/user/appdata/zilcho-subs
WEB_PORT=8765
PUID=99
PGID=100
TZ=Etc/UTC
CPU_LIMIT=2
MEMORY_LIMIT=6g
